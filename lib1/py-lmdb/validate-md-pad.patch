+	/** Bound #MDB_db.%md_pad, the LEAF2 fixed key size, as read from disk.
+	 *	Returns 0 if valid, non-zero if corrupt.
+	 *
+	 *	A LEAF2 key must fit in a page's usable space.  #LEAF2KEY() turns
+	 *	md_pad into a pointer offset and several callers hand it to the
+	 *	user as a buffer length, so an unbounded value is an out-of-bounds
+	 *	read; #mdb_node_add() uses it as a memmove()/memcpy() length, which
+	 *	makes it an out-of-bounds write.
+	 *
+	 *	Zero is deliberately accepted here: md_pad is unused unless the
+	 *	DB's own pages are LEAF2, and #mdb_dbi_open() zeroes the whole
+	 *	record when creating a DB, so a perfectly normal #MDB_DUPFIXED
+	 *	database has md_pad == 0.  Only a DUPFIXED *sub*-DB, whose pages
+	 *	are always LEAF2, additionally requires a non-zero value; see
+	 *	#mdb_xcursor_init1().
+	 *
+	 *	Must not be applied to #FREE_DBI, whose md_pad aliases #mm_psize
+	 *	and legitimately equals the full page size.  That field is checked
+	 *	separately where the meta page is read.
+	 */
+#define BAD_MD_PAD(pad, psize)	((pad) > (psize) - PAGEHDRSZ)
+
+	/** Bound the keys a LEAF2 page claims to hold.
+	 *	Returns 0 if valid, non-zero if corrupt.  `space' is the usable
+	 *	bytes after the page header.
+	 *
+	 *	#mdb_node_add() keeps mp_upper - mp_lower equal to
+	 *	space - #NUMKEYS()*ksize on a LEAF2 page, so NUMKEYS()*ksize
+	 *	never exceeds space on a page LMDB built.  Bounding the key size
+	 *	alone does not imply that, because the two halves are read from
+	 *	different places: the size from an #MDB_db record or a sub-page
+	 *	header, the count from the page.  Forging one and not the other
+	 *	leaves both individually in range while #LEAF2KEY() still
+	 *	addresses far outside the page -- on a 16KB page a key size of
+	 *	4096 is a legal value that still walks megabytes past the end.
+	 *
+	 *	ksize must already be bounded by space, or the product can
+	 *	overflow; #BAD_LEAF2_PAD() does both in the right order.
+	 */
+#define BAD_LEAF2_KEYS(p, ksize, space) \
+	((unsigned)NUMKEYS(p) * (unsigned)(ksize) > (unsigned)(space))
+
+	/** Bound a LEAF2 fixed key size and the keys it describes.
+	 *	Returns 0 if valid, non-zero if corrupt.  Zero is rejected: it
+	 *	makes #LEAF2KEY() return the same pointer for every index, and
+	 *	divisions by it appear in the split path.  Unlike #BAD_MD_PAD()
+	 *	this needs the page, so it is only usable once one is in hand.
+	 */
+#define BAD_LEAF2_PAD(p, ksize, space) \
+	((ksize) == 0 || (unsigned)(ksize) > (unsigned)(space) || \
+	 BAD_LEAF2_KEYS(p, ksize, space))
+
 	/** Handle for the DB used to track free pages. */
 #define	FREE_DBI	0
