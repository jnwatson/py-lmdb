@@ -2718,8 +2718,9 @@
 	return oldest;
 }
 
-/** Add a page to the txn's dirty list, if there is one */
-static void
+/** Add a page to the txn's dirty list, if there is one.
+ * @return 0 on success, MDB_CORRUPTED if the page number is already listed. */
+static int
 mdb_page_dirty(MDB_txn *txn, MDB_page *mp)
 {
 	MDB_ID2 mid;
@@ -2727,13 +2728,22 @@
 
 	if (txn->mt_flags & MDB_TXN_WRITEMAP) {
 		txn->mt_flags |= MDB_TXN_DIRTY;
-		return;
+		return MDB_SUCCESS;
 	}
 	mid.mid = mp->mp_pgno;
 	mid.mptr = mp;
 	rc = mdb_mid2l_insert(txn->mt_u.dirty_list, &mid);
-	mdb_tassert(txn, rc == 0);
+	if (rc) {
+		/* insert returns -1 when the page number is already present: a
+		 * forged freeDB record listed the same page twice, so the same
+		 * pgno was handed out and dirtied twice in one txn.  Upstream
+		 * asserts here (abort); return MDB_CORRUPTED for the caller to
+		 * propagate instead. */
+		txn->mt_flags |= MDB_TXN_ERROR;
+		return MDB_CORRUPTED;
+	}
 	txn->mt_dirty_room--;
+	return MDB_SUCCESS;
 }
 
 /** Allocate page numbers and memory for writing.  Maintain me_pglast,
@@ -2894,6 +2904,18 @@
 			goto fail;
 
 		idl = (MDB_ID *) data.mv_data;
+		/* A freeDB record is an IDL: idl[0] elements follow, so its node
+		 * spans exactly (idl[0]+1)*sizeof(MDB_ID) bytes.  Nothing checked
+		 * that against the node size, so a forged count drove the
+		 * mdb_midl_need() below and mdb_midl_xmerge() past the end of the
+		 * node (SIGBUS, garbage merged into me_pghead).  Check mv_size
+		 * before reading idl[0]. */
+		if (data.mv_size < sizeof(MDB_ID) ||
+			data.mv_size % sizeof(MDB_ID) != 0 ||
+			idl[0] != data.mv_size / sizeof(MDB_ID) - 1) {
+			rc = MDB_CORRUPTED;
+			goto fail;
+		}
 		i = idl[0];
 		if (!mop) {
