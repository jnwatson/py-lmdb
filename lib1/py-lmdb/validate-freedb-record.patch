@@ -2943,6 +2965,20 @@
 #endif
 
 search_done:
+	/* A pgno reused from the freeDB (i != 0) reaches here having skipped
+	 * the me_maxpg bound the fresh-page path above applies to
+	 * mt_next_pgno.  A crafted record can name any 64-bit pgno; under
+	 * MDB_WRITEMAP the store through me_map just below then lands outside
+	 * the map (SIGSEGV), and without it mdb_page_flush() later pwrites at
+	 * an arbitrary file offset.  A freed page is by definition an
+	 * allocated one, so it must fall in [NUM_METAS, mt_next_pgno) with
+	 * room for num pages; the clause order keeps the subtraction from
+	 * wrapping. */
+	if (i && (pgno < NUM_METAS || pgno >= txn->mt_next_pgno ||
+		num > txn->mt_next_pgno - pgno)) {
+		rc = MDB_CORRUPTED;
+		goto fail;
+	}
 	if (env->me_flags & MDB_WRITEMAP) {
